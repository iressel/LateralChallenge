# Copy this file to the ignored local .env file and populate every placeholder outside source control.
# The Compose path accepts SQL passwords made from letters, digits, and !@#%^*_.+=,?- only.
# All four SQL passwords must be strong and distinct. Never commit populated credentials.

MSSQL_SA_PASSWORD=<generate-a-distinct-strong-local-sa-password>
MIGRATION_SQL_PASSWORD=<generate-a-distinct-strong-local-migration-password>
WRITE_SQL_PASSWORD=<generate-a-distinct-strong-local-write-password>
READ_SQL_PASSWORD=<generate-a-distinct-strong-local-read-password>

Authentication__Credentials__Cms__Username=<choose-a-distinct-cms-username-10-to-20-characters>
Authentication__Credentials__Cms__Password=<generate-a-distinct-guid-d-format-value-for-cms>
Authentication__Credentials__Consumer__Username=<choose-a-distinct-consumer-username>
Authentication__Credentials__Consumer__Password=<generate-a-distinct-guid-d-format-value-for-consumer>
Authentication__Credentials__Administrator__Username=<choose-a-distinct-administrator-username>
Authentication__Credentials__Administrator__Password=<generate-a-distinct-guid-d-format-value-for-administrator>

# Optional non-secret local port overrides.
SQL_SERVER_PORT=14333
CMS_API_PORT=8080

# Optional image override. Keep this exact verified pin unless a replacement is separately verified.
SQL_SERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-CU26-ubuntu-22.04@sha256:ba4c8329f48fb8f02e1416be6a930ebfd71268caee78aa985f3af4315e457c89
