# Copy this file to the ignored local .env file and populate it outside source control.
# Never commit populated credentials or connection strings.

ConnectionStrings__WriteDatabase=<set-write-database-connection-outside-source-control>
ConnectionStrings__ReadDatabase=<set-read-database-connection-outside-source-control>

Authentication__Cms__Username=<cms-username-must-be-10-to-20-characters>
Authentication__Cms__Password=<random-guid-format-password-required-later>
Authentication__NormalConsumer__Username=<normal-consumer-username>
Authentication__NormalConsumer__Password=<random-guid-format-password-required-later>
Authentication__Administrator__Username=<administrator-username>
Authentication__Administrator__Password=<random-guid-format-password-required-later>

# T015 may use this key for a local SQL Server container. Supply a strong local-only value then.
MSSQL_SA_PASSWORD=<secure-container-password-to-be-supplied-in-t015>
